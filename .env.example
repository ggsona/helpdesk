APP_NAME="HelpDesk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-app.onrender.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------
# BASE DE DATOS - TiDB Serverless (MySQL compatible)
# Obtén estos datos desde: https://tidbcloud.com
# -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=helpdesk
DB_USERNAME=tu_usuario.root
DB_PASSWORD=tu_password
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# -----------------------------------------------
# IMAGEKIT.IO - Almacenamiento de archivos
# Obtén tus claves desde: https://imagekit.io/dashboard/developer/api-keys
# -----------------------------------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Proxies de confianza (requerido en Render/cualquier PaaS con load balancer)
TRUSTED_PROXIES=*

MAIL_MAILER=log
MAIL_FROM_ADDRESS="helpdesk@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
